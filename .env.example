# Astrail local environment template
#
# Repo root/backend:
#   use these values for FastAPI, Render, Supabase server access, and agent jobs.
#
# Frontend:
#   Next.js reads env files from frontend/.env.local when run from frontend/.
#   Copy only the "Frontend public" section there for local UI work.
#
# Team handoff:
#   Shaun/backend owns the backend-only secrets below.
#   Zhi Hao/frontend owns the NEXT_PUBLIC_* values below.
#   Share the same dev Supabase project unless intentionally testing isolation.

# Backend required - server only, never expose to the browser
OPENAI_API_KEY=
APIFY_TOKEN=
SUPABASE_URL=https://<shared-dev-project-ref>.supabase.co   # also the JWKS source for auth (ES256/asymmetric)
SUPABASE_SERVICE_ROLE_KEY=                                   # sb_secret_… (or legacy service_role); server-only
# SUPABASE_JWT_SECRET removed — project uses asymmetric ES256 signing keys (verified via JWKS), no shared secret
# ASTRAIL_TEST_USER_ID=                                      # test-only: a seeded dev user UID, for the RUN_DB_INTEGRATION integration test
MAPBOX_SECRET_TOKEN=sk.<mapbox-secret-token>
MEM0_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# Backend optional - defaults used by the pipeline
LANGFUSE_HOST=https://cloud.langfuse.com
EXTRACTION_TIMEOUT=80
PIPELINE_TIMEOUT=180
HEARTBEAT_INTERVAL=5
SEMANTIC_DEDUP_THRESHOLD=0.85
PLACE_LATLNG_DISTANCE_M=500
MAX_PLACES_PER_TRIP=8
MAX_REELS_PER_REQUEST=5
REEL_CACHE_TTL_DAYS=30
MAX_TRIPS_PER_USER_PER_DAY=3

# Frontend public - browser-visible values only
NEXT_PUBLIC_SUPABASE_URL=https://<shared-dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.<mapbox-public-token>
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Dashboard/service config, not app env vars
# - Supabase Auth Google OAuth is configured in the Supabase dashboard.
# - Render uses the backend required keys above.
# - Vercel uses the frontend public keys above.
# - UptimeRobot monitors GET /health.

# Intentionally absent in V1
# - Open-Meteo has no API key.
# - Travala MCP integration has no app env var until the implementation defines one.
# - Do not add CLERK_*, CONVEX_*, MAPBOX_ACCESS_TOKEN, AP2_*, X402_*,
#   DUFFEL_TEST_TOKEN, BOOKING_AID, DEMO_REEL_URL*, or USE_CACHE.
