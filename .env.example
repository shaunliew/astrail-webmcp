# Astrail local environment template
#
# Repo root/backend:
#   use these values for FastAPI, Render, Supabase server access, and agent jobs.
#
# Frontend:
#   Next.js reads env files from frontend/.env.local when run from frontend/.
#   Copy only the "Frontend public" section there for local UI work.
#
# Team handoff:
#   Shaun/backend owns the backend-only secrets below.
#   Zhi Hao/frontend owns the NEXT_PUBLIC_* values below.
#   Share the same dev Supabase project unless intentionally testing isolation.

# Backend required - server only, never expose to the browser
OPENAI_API_KEY=
APIFY_TOKEN=
SUPABASE_URL=https://<shared-dev-project-ref>.supabase.co   # also the JWKS source for auth (ES256/asymmetric)
SUPABASE_SERVICE_ROLE_KEY=                                   # sb_secret_… (or legacy service_role); server-only
# SUPABASE_JWT_SECRET removed — project uses asymmetric ES256 signing keys (verified via JWKS), no shared secret
# ASTRAIL_TEST_USER_ID=                                      # test-only: a seeded dev user UID, for the RUN_DB_INTEGRATION integration test
MAPBOX_SECRET_TOKEN=sk.<mapbox-secret-token>
MEM0_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SENTRY_DSN removed (ISSUES-B1) — sentry-sdk was never wired, and its FastAPI integration
# captures full request URLs, which would reintroduce the ?token=<JWT> access-log leak.
# Resend transactional email — account-deletion notices only (notifications.py). BEST-EFFORT and
# DORMANT-safe: unset RESEND_API_KEY = every notice is a logged no-op (no send, never blocks a
# deletion), so leaving these blank is safe. Set to go live at Task 6.
RESEND_API_KEY=
# Sender on the send. subdomain (SPF/DKIM live there); the default above is used if unset.
# The comment MUST stay on its own line: Render's env UI takes the whole line after `=` as the
# value, so an inline `#` after this unquoted, space-bearing address would become part of the
# From header and make it an invalid sender.
RESEND_FROM_EMAIL=Astrail <no-reply@send.astrail.xyz>

# Backend optional - defaults used by the pipeline
LANGFUSE_HOST=https://cloud.langfuse.com
EXTRACTION_TIMEOUT=80
PIPELINE_TIMEOUT=180
HEARTBEAT_INTERVAL=5
SEMANTIC_DEDUP_THRESHOLD=0.85
PLACE_LATLNG_DISTANCE_M=500
MAX_PLACES_PER_TRIP=8
MAX_REELS_PER_REQUEST=5
REEL_CACHE_TTL_DAYS=30
# MAX_TRIPS_PER_USER_PER_DAY=3   # SUPERSEDED / never wired — the live per-user daily cap is DAILY_TRIP_QUOTA below
DAILY_TRIP_QUOTA=5              # per-user daily trip-generation cap (rate_limit.py); durable free-tier hard cap
BURST_LIMIT=3/minute           # per-user burst throttle on the Apify/OpenAI-spending routes (slowapi, in-memory)
SAVE_LIMIT=30/minute           # per-user burst on POST /saved-reels only — a pure DB insert, no Apify (rate_limit.py)
ALLOWED_ORIGINS=https://astrail.xyz,https://www.astrail.xyz   # CORS allowlist (comma-separated); local dev: set to * ; add Vercel preview origins at deploy

# Worker only - read by the astrail-telegram-ingest Render worker, NOT by the web service.
# That worker also needs the five backend required secrets above (OPENAI_API_KEY,
# APIFY_TOKEN, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, MAPBOX_SECRET_TOKEN) and nothing
# else - see .claude/docs/ENV.md for what is deliberately absent from it.
TELEGRAM_BOT_TOKEN=                                          # from @BotFather; blank = boot failure
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890                     # fail-CLOSED allowlist, comma-separated chat ids; unset/blank/"," = boot failure, NEVER "allow all"
ASTRAIL_INGEST_USER_ID=<uuid-of-the-ingest-row-in-public.users>   # must name an existing public.users row or the worker refuses to boot

# Frontend public - browser-visible values only
NEXT_PUBLIC_SUPABASE_URL=https://<shared-dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.<mapbox-public-token>
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Real auth for the beta flow — mock auth must stay OFF
NEXT_PUBLIC_MOCK_AUTH=false

# Dashboard/service config, not app env vars
# - Supabase Auth Google OAuth is configured in the Supabase dashboard.
# - Render uses the backend required keys above.
# - Vercel uses the frontend public keys above.
# - UptimeRobot monitors GET /health.

# Intentionally absent in V1
# - Open-Meteo has no API key.
# - Travala MCP integration has no app env var until the implementation defines one.
# - Do not add CLERK_*, CONVEX_*, MAPBOX_ACCESS_TOKEN, AP2_*, X402_*,
#   DUFFEL_TEST_TOKEN, BOOKING_AID, DEMO_REEL_URL*, or USE_CACHE.
