{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astrail-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "astrail-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "--env-file", ".env", "uvicorn", "main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
