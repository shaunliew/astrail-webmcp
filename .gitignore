# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.uv/
dist/
*.egg-info/

# Environment
.env
.env.local
.env.*.local
backend/env
frontend/env.local
# Copies of an env file are still an env file. A backup taken before flipping a
# flag (.env.local.bak-mockauth) carries every key the original did, and the
# rules above do not match it.
.env*.bak*
.env*.backup*
*.env.bak

# Node
node_modules/
.next/
out/
*.tsbuildinfo
checkpoint*.png
design-*.png
.next-dev-*.log

# Local design reference/mockups, not shipped app code
design-mockup/
frontend/reference/yaay-corefeature/
frontend/reference/yaay-onboarding/

# Supabase
supabase/.branches/
supabase/.temp/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Local agent brainstorming artifacts
.superpowers/

# Shiplog queue (local only, processed via /shiplog)
.shiplog_queue.md

# Local live-capture output for inspection (never committed; refresh real fixtures with --out-dir evals/fixtures)
backend/captures/

# pytest basetemp redirect (default %TEMP%/pytest-of-* is permission-locked on this machine)
backend/.pytest-tmp*/
backend/tmpastrail-pytest*/
.pytest_cache/
.uv-cache/

# Graphify local knowledge-graph output (regenerate with `graphify update backend`)
graphify-out/
.gstack/

# Machine-local Claude permissions and MCP toggles
.claude/settings.local.json

