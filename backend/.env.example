# Astrail BACKEND environment template — server-side only, never exposed to the browser.
#
# SCOPE: this file lists only what `backend/` code actually reads. It was derived from the
# source (`os.environ` / `os.getenv` across backend/, excluding tests and scripts), not copied
# from another template — so if a variable is here, something reads it.
#
# The repo-root `.env.example` is the TEAM-WIDE template: it also carries the frontend
# `NEXT_PUBLIC_*` values Zhi Hao owns, plus the handoff notes. Use this file when you are
# working in `backend/` or filling in a Render service form; use the root one when you want
# the whole picture.
#
# USAGE: copy to `backend/.env` (gitignored) and fill in. `python-dotenv` loads it via
# `load_dotenv(find_dotenv())`. Never commit a filled-in copy — `.gitignore` blocks `.env`,
# `.env.local` and `.env*.bak*` for that reason.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — both services. Boot FAILS without these.
#
# `config_validation.validate_required_secrets()` raises at startup naming EVERY missing one
# at once (blank and whitespace-only count as missing). It runs BEFORE any error handling, so
# a missing value is a loud crash, never a silently degraded process.
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=
APIFY_TOKEN=
SUPABASE_URL=https://<project-ref>.supabase.co   # also the JWKS source for ES256 auth (auth.py)
SUPABASE_SERVICE_ROLE_KEY=                       # sb_secret_… — bypasses RLS, server-only, never ship to a client
MAPBOX_SECRET_TOKEN=sk.<mapbox-secret-token>     # sk. not pk. — read by grounding.py::_ground_place


# ─────────────────────────────────────────────────────────────────────────────
# WEB SERVICE ONLY — `astrail-backend`. The Telegram worker reads none of these.
# ─────────────────────────────────────────────────────────────────────────────

# CORS allowlist (main.py). `*` is LOCAL-DEV ONLY — never in a deployed env (allow_credentials=True
# + `*` = any-origin-with-credentials).
ALLOWED_ORIGINS=https://astrail.xyz,https://www.astrail.xyz
BURST_LIMIT=3/minute        # per-user burst on the Apify/OpenAI-spending routes (rate_limit.py, slowapi, in-memory)
SAVE_LIMIT=30/minute        # per-user burst on POST /saved-reels only — pure DB insert, no Apify (rate_limit.py)
DAILY_TRIP_QUOTA=5          # per-user durable daily cap (rate_limit.py:32)
TRIAL_LIFETIME_LIMIT=1      # generations a `plan='trial'` user gets EVER. Does not reset; only a
                            # beta seat lifts it (rate_limit.py:39). A judge account on the trial
                            # plan gets ONE generation for the whole judging period — put judge
                            # accounts on `plan='beta'` instead.
ENTITLEMENTS_ENABLED=true   # rollback switch (rate_limit.py:45). Enabled unless explicitly
                            # false/0/no/off, so a typo keeps enforcement ON rather than silently
                            # dropping to the legacy daily-quota path.

# WebMCP write surface: the five agent edit tools (move/remove/add place, set dates, replan).
# DEFAULT OFF. While unset, every edit endpoint returns a bare 404 and the agent tells the judge
# "That trip or stop was not found — or trip editing is not enabled on this deployment."
# Set it true on the hackathon deployment or the edit half of the demo cannot be shown.
# ⚠ Parse asymmetry, deliberate but easy to trip over: this is enabled by ANY value that is not
# false/0/no/off (main.py:117), so `WEBMCP_EDITS_ENABLED=ture` ENABLES writes. That is the opposite
# posture to RUN_DELETION_SWEEP below, which arms only on the exact string "true". Both are correct
# for what they gate — an accidental write is recoverable, an accidental deletion sweep is not.
WEBMCP_EDITS_ENABLED=false

# 🚨 THE MOST DANGEROUS LINE IN THIS FILE. Arms the destructive account-deletion sweep, which runs
# every 120s and permanently deletes users whose grace period has expired. EXACTLY ONE deployment
# may set it (main.py:168, armed only on the literal string "true").
# LEAVE IT UNSET on any second backend — a staging, hackathon or local service pointed at the SAME
# Supabase project will otherwise sweep REAL user accounts. Absent is the safe value; that is why
# there is no `=` on the line below.
# RUN_DELETION_SWEEP
MEM0_API_KEY=               # OPTIONAL. Absent = memory disabled, never a boot failure (guardrail #3).
                            # Deliberately NOT in REQUIRED_SECRETS — mem0 is reported, never required.

# PORT is injected by Render; do not set it here.


# ─────────────────────────────────────────────────────────────────────────────
# WORKER ONLY — `astrail-telegram-ingest`. The web service reads none of these.
#
# The worker needs these THREE plus the five REQUIRED above = EIGHT total, and nothing else.
# All eight must be present BEFORE its first start: config validation is fatal, so a worker
# created with blanks crash-loops immediately.
# ─────────────────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
# From @BotFather. Blank = boot failure. Also run `/setprivacy → Disable` so the bot can see
# plain-URL messages even if it is ever demoted from group admin.

TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
# FAILS CLOSED — this is the bot's entire authorization surface. Unset, blank, whitespace-only
# or "," is a BOOT FAILURE, never "allow everything": the worst failure mode is the bot being
# added to a stranger's group and spending Apify + OpenAI credits on it.
# Comma-separated. Supergroup ids are NEGATIVE — keep the minus sign. `0` is rejected.
# Parsed with a strict `-?[0-9]+`: `4_2` and Unicode digits like `٤٢` are REJECTED, because
# int() would otherwise accept them and authorize a chat other than the one you can read here.

ASTRAIL_INGEST_USER_ID=<uuid>
# The shared ingest service account. Must name an existing `public.users` row or the worker
# refuses to boot. Create it via Supabase dashboard → Auth → Add User (that path fires the
# on_auth_user_inserted trigger); NEVER insert into auth.users directly.


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — model overrides. Each falls back to the module's DEFAULT_MODEL if unset.
# ─────────────────────────────────────────────────────────────────────────────

# ASTRAIL_EXTRACT_MODEL=       # genagents/place_extractor.py:313
# ASTRAIL_NARRATOR_MODEL=      # genagents/narrator.py:119
# ASTRAIL_RESTAURANT_MODEL=    # genagents/restaurant.py:208


# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV / TEST ONLY — never set in production.
# ─────────────────────────────────────────────────────────────────────────────

# RUN_DB_INTEGRATION=1                    # opt in to the DB integration tests
# ASTRAIL_TEST_USER_ID=<uuid>             # a seeded dev user, required by those tests
# ASTRAIL_LOCAL_SUPABASE_URL=             # point pgTAP/local runs at `supabase start`
# ASTRAIL_LOCAL_SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Direct Postgres DSN read by test_reserve_enqueue_race.py (the two-session concurrency race
#   test). Defaults to the local `supabase start` value above if unset — override only to point
#   the race test at a different local stack. Never a production DSN (the test writes + deletes).
# SMOKE_BASE_URL= / SMOKE_JWT= / SMOKE_PROVISION=   # backend/scripts/smoke_*.py


# ─────────────────────────────────────────────────────────────────────────────
# DELIBERATELY ABSENT — do not add these back without checking why they went.
# ─────────────────────────────────────────────────────────────────────────────
#
# SUPABASE_JWT_SECRET  Removed. Auth verifies asymmetric ES256 via JWKS derived from
#                      SUPABASE_URL. Requiring it would block boot on a secret the project
#                      intentionally dropped (see config_validation.py's module docstring).
#
# LANGFUSE_*           No backend code reads them. `pipeline/tracing.py`'s default tracer is a
#                      pure no-op and nothing imports langfuse. The root template still lists
#                      them as intent; they are not wired.
#
# SENTRY_DSN           OPTIONAL error monitoring (re-added 2026-08-07). DORMANT-safe: unset =
#                      observability.init_sentry() no-ops, nothing ships. The ISSUES-B1 request-URL
#                      capture hole is closed by observability.py's before_send scrubber
#                      (+ send_default_pii=False, traces_sample_rate=0.0). Guarded by
#                      test_observability.py. Optional SENTRY_ENVIRONMENT (defaults to "production").
